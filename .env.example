# ── Answer generator (Groq) ─────────────────────────────────────
# Get a free Groq API key at https://console.groq.com
GROQ_API_KEY=PASTE_YOUR_GROQ_API_KEY_HERE
LLM_PROVIDER=groq
LLM_MODEL_NAME=llama-3.1-8b-instant

# ── Evaluator LLM ────────────────────────────────────────────────
# Option A: Gemini
#   Get a free Gemini API key at https://aistudio.google.com/apikey
#   Set EVALUATOR_PROVIDER=gemini and EVALUATOR_MODEL_NAME=gemini-1.5-flash-8b
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
#
# Option B: Mistral AI (recommended for N=1 evaluation consistency)
#   Get a free Mistral API key at https://console.mistral.ai
#   Set EVALUATOR_PROVIDER=mistral and EVALUATOR_MODEL_NAME=ministral-8b-2512
MISTRAL_API_KEY=PASTE_YOUR_MISTRAL_API_KEY_HERE
#
# Option C: Groq (uses same GROQ_API_KEY set above)
#   Set EVALUATOR_PROVIDER=groq and EVALUATOR_MODEL_NAME=llama-3.3-70b-versatile
EVALUATOR_PROVIDER=mistral
EVALUATOR_MODEL_NAME=ministral-8b-2512
